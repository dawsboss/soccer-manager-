# Read by the functions at deploy (firebase deploy loads functions/.env).
# Not a secret: it is the site's own public address. Calendar entries on the
# share pages' and My calendar's feeds link back here (functions/calendar.js),
# and a share page sends a signed-in visitor through it (functions/mirror.js).
SOCCER_SITE=https://dawsboss.github.io/soccer-manager-/index.html
# The address the club's emails are sent as (functions/mail.js). Set it with
# the SMTP secret (README, "Email from the club"); blank, and nothing is sent.
SOCCER_MAIL_FROM=
